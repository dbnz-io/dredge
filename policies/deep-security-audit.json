{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentityAndOrganizationAssessment",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*",
        "iam:GenerateCredentialReport",
        "iam:GenerateServiceLastAccessedDetails",
        "iam:SimulateCustomPolicy",
        "iam:SimulatePrincipalPolicy",
        "organizations:Describe*",
        "organizations:List*",
        "account:Get*",
        "account:List*",
        "sso:Describe*",
        "sso:Get*",
        "sso:List*",
        "identitystore:Describe*",
        "identitystore:List*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkloadConfigurationAndArtifacts",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:Get*",
        "ebs:GetSnapshotBlock",
        "ebs:List*",
        "ecs:Describe*",
        "ecs:List*",
        "eks:Describe*",
        "eks:List*",
        "eks:AccessKubernetesApi",
        "lambda:Get*",
        "lambda:List*",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:Describe*",
        "ecr:Get*",
        "ecr:List*",
        "elasticbeanstalk:Describe*",
        "elasticbeanstalk:List*",
        "elasticbeanstalk:RetrieveEnvironmentInfo",
        "apprunner:Describe*",
        "apprunner:List*",
        "batch:Describe*",
        "batch:List*",
        "glue:BatchGetJobs",
        "glue:BatchGetCrawlers",
        "glue:BatchGetDevEndpoints",
        "glue:BatchGetTriggers",
        "glue:BatchGetWorkflows",
        "glue:BatchGetPartition",
        "glue:GetJob*",
        "glue:GetConnection*",
        "glue:GetCrawler*",
        "glue:GetDatabase*",
        "glue:GetTable*",
        "glue:GetPartition*",
        "glue:GetSecurityConfiguration*",
        "glue:GetDevEndpoint*",
        "glue:GetWorkflow*",
        "glue:GetTrigger*",
        "glue:GetResourcePolic*",
        "glue:GetCatalog*",
        "glue:GetTags",
        "glue:ListJobs",
        "glue:ListCrawlers",
        "glue:ListDevEndpoints",
        "glue:ListTriggers",
        "glue:ListWorkflows",
        "codebuild:BatchGet*",
        "codebuild:List*",
        "amplify:Get*",
        "amplify:List*",
        "cloudformation:Describe*",
        "cloudformation:Get*",
        "cloudformation:List*",
        "appconfig:Get*",
        "appconfig:List*",
        "sagemaker:Describe*",
        "sagemaker:List*",
        "states:Describe*",
        "states:GetExecutionHistory",
        "states:List*",
        "autoscaling:Describe*",
        "elasticloadbalancing:Describe*",
        "rds:Describe*",
        "rds:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretValuesAndEncryptedEvidence",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:List*",
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue",
        "ssm:Describe*",
        "ssm:GetAutomationExecution",
        "ssm:GetCalendar*",
        "ssm:GetCloudConnector",
        "ssm:GetCommandInvocation",
        "ssm:GetConnectionStatus",
        "ssm:GetDefaultPatchBaseline",
        "ssm:GetDeployablePatchSnapshotForInstance",
        "ssm:GetDocument",
        "ssm:GetExecutionPreview",
        "ssm:GetInventory*",
        "ssm:GetMaintenanceWindow*",
        "ssm:GetManifest",
        "ssm:GetOps*",
        "ssm:GetParameter*",
        "ssm:GetPatchBaseline*",
        "ssm:GetResourcePolicies",
        "ssm:GetServiceSetting",
        "ssm:List*",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:GetPublicKey",
        "kms:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3EvidenceAndConfigurationFiles",
      "Effect": "Allow",
      "Action": [
        "s3:List*",
        "s3:GetBucket*",
        "s3:GetAccountPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetObject*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsMetricsAndConfigurationHistory",
      "Effect": "Allow",
      "Action": [
        "logs:Describe*",
        "logs:Get*",
        "logs:List*",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:StopQuery",
        "logs:Unmask",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "cloudtrail:Describe*",
        "cloudtrail:Get*",
        "cloudtrail:List*",
        "cloudtrail:LookupEvents",
        "cloudtrail:StartQuery",
        "cloudtrail:CancelQuery",
        "config:BatchGet*",
        "config:Describe*",
        "config:Get*",
        "config:List*",
        "config:SelectResourceConfig",
        "config:SelectAggregateResourceConfig",
        "tag:Get*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityServicesAndFindings",
      "Effect": "Allow",
      "Action": [
        "securityhub:BatchGet*",
        "securityhub:Describe*",
        "securityhub:Get*",
        "securityhub:List*",
        "guardduty:Describe*",
        "guardduty:Get*",
        "guardduty:List*",
        "inspector:Describe*",
        "inspector:Get*",
        "inspector:List*",
        "inspector2:BatchGet*",
        "inspector2:Describe*",
        "inspector2:Get*",
        "inspector2:List*",
        "macie2:Describe*",
        "macie2:Get*",
        "macie2:List*",
        "macie2:SearchResources",
        "detective:BatchGet*",
        "detective:Get*",
        "detective:List*",
        "detective:SearchGraph",
        "securitylake:Get*",
        "securitylake:List*",
        "access-analyzer:Get*",
        "access-analyzer:List*",
        "access-analyzer:ValidatePolicy",
        "access-analyzer:CheckAccessNotGranted",
        "access-analyzer:CheckNoNewAccess",
        "access-analyzer:CheckNoPublicAccess",
        "fms:Get*",
        "fms:List*",
        "shield:Describe*",
        "shield:Get*",
        "shield:List*",
        "waf:Get*",
        "waf:List*",
        "waf-regional:Get*",
        "waf-regional:List*",
        "wafv2:Describe*",
        "wafv2:Get*",
        "wafv2:List*",
        "network-firewall:Describe*",
        "network-firewall:List*",
        "route53resolver:Get*",
        "route53resolver:List*",
        "auditmanager:Get*",
        "auditmanager:List*",
        "security-ir:BatchGet*",
        "security-ir:GetCase",
        "security-ir:GetCaseAttachmentDownloadUrl",
        "security-ir:GetFindingMetrics",
        "security-ir:GetMembership",
        "security-ir:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EdgeApisAndCertificateInspection",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "cloudfront:Get*",
        "cloudfront:List*",
        "acm:DescribeCertificate",
        "acm:GetCertificate",
        "acm:List*",
        "acm-pca:Describe*",
        "acm-pca:Get*",
        "acm-pca:List*"
      ],
      "Resource": "*"
    }
  ]
}
